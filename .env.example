# Local backend only. Never put API keys in dist/ or commit .env.
API_BASE_URL=
API_MODEL=
API_KEY=
PORT=8766
API_JSON_MODE=true
API_CHUNK_CHARS=12000
API_MAX_CHUNKS=40
API_MAX_OUTPUT_TOKENS=6000
# Select max_tokens or max_completion_tokens for your provider/model.
API_TOKEN_PARAMETER=max_tokens
API_TIMEOUT_MS=90000
