            "brief": {
              "zh": "本案例数字与流程只用于接口演练。",
              "en": "The numbers and sequence in this case are for acceptance testing."
            },
            "rounds": [
              {
                "id": "release",
                "type": "order",
                "prompt": {
                  "zh": "本演练给定的步骤是先记录基线，再比较测试结果，最后受控上线。这是本案例的演练顺序，不宣称所有项目只有这一种流程。",
                  "en": "The sequence given in this exercise is to record a baseline, compare test results, then release under controls. This is the case sequence, not a universal project lifecycle."
                },
                "reason": {
                  "zh": "先建立比较依据，再验证，最后受控发布。",
                  "en": "Establish a comparison baseline, validate, then release under controls."
                },
                "items": [
                  {
                    "id": "baseline",
                    "text": {
                      "zh": "记录基线",
                      "en": "Record baseline"
                    }
                  },
                  {
                    "id": "compare",
                    "text": {
                      "zh": "比较测试",
                      "en": "Compare tests"
                    }
                  },
                  {
                    "id": "release",
                    "text": {
                      "zh": "受控上线",
                      "en": "Controlled release"
                    }
                  }
                ],
                "expected": [
                  "baseline",
                  "compare",
                  "release"
                ],
                "unitIds": [
                  "unit-4"
                ]
              }
            ]
          },
          "questions": [
