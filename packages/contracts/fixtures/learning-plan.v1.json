  "chapters": [
    {
      "id": "chapter-1",
      "title": {
        "zh": "规则与学习",
        "en": "Rules and learning"
      },
      "sections": [
        {
          "id": "section-1",
          "title": {
            "zh": "规则与学习",
            "en": "Rules and learning"
          },
          "prerequisiteSectionIds": [],
          "learnUnitIds": [
            "unit-1"
          ],
          "activity": {
            "version": 1,
            "kind": "switchboard",
            "title": {
              "zh": "演练装置1",
              "en": "Exercise device 1"
            },
            "brief": {
              "zh": "本案例数字与流程只用于接口演练。",
              "en": "The numbers and sequence in this case are for acceptance testing."
            },
            "rounds": [
              {
                "id": "route",
                "type": "sort",
                "prompt": {
                  "zh": "把本演练的两项工作送到合适的方案窗口。",
                  "en": "Route the two exercise tasks to their appropriate solution."
                },
                "reason": {
                  "zh": "明确的固定政策用规则；从数据学习的预测用机器学习。",
                  "en": "Use rules for fixed policy and machine learning for a prediction learned from data."
                },
                "bins": [
                  {
                    "id": "rules",
                    "text": {
                      "zh": "规则",
                      "en": "Rules"
                    }
                  },
                  {
                    "id": "ml",
                    "text": {
                      "zh": "机器学习",
                      "en": "Machine learning"
                    }
                  }
                ],
                "items": [
                  {
                    "id": "expense",
                    "text": {
                      "zh": "固定报销审批",
                      "en": "Fixed expense approval"
                    },
                    "target": "rules"
                  },
                  {
                    "id": "demand",
                    "text": {
                      "zh": "需求预测",
                      "en": "Demand forecasting"
                    },
                    "target": "ml"
                  }
                ],
                "unitIds": [
                  "unit-1"
                ]
              }
            ]
          },
          "questions": [
            {
              "id": "question-1",
              "unitIds": [
                "unit-1"
              ],
              "q": "本演练的固定报销审批使用什么方案？",
              "a": "规则",
              "wrong": [
                "机器学习"
              ],
              "en": {
                "q": "Which solution handles fixed expense approval?",
                "a": "Rules",
                "wrong": [
                  "Machine learning"
                ]
              },
              "quote": "规则把明确条件映射为动作；机器学习从数据学习模式。本演练中，固定报销审批使用规则，需求预测使用机器学习。",
              "mode": "scenario"
            }
          ]
        }
      ]
    },
    {
      "id": "chapter-2",
      "title": {
        "zh": "完整成本与ROI",
        "en": "Full cost and ROI"
      },
      "sections": [
        {
          "id": "section-2",
          "title": {
            "zh": "完整成本与ROI",
            "en": "Full cost and ROI"
          },
          "prerequisiteSectionIds": [],
          "learnUnitIds": [
            "unit-2"
          ],
          "activity": {
            "version": 1,
            "kind": "ledger",
            "title": {
              "zh": "演练装置2",
              "en": "Exercise device 2"
            },
            "brief": {
              "zh": "本案例数字与流程只用于接口演练。",
              "en": "The numbers and sequence in this case are for acceptance testing."
            },
            "rounds": [
              {
                "id": "roi",
                "type": "number",
                "prompt": {
                  "zh": "本演练在同一期间的部署成本为40，运行成本为60，已兑现收益为150。完整成本100，净收益50，简单ROI为50%。",
                  "en": "In this exercise, deployment costs 40, operations cost 60 and realized benefits are 150 in the same period. Total cost is 100, net benefit is 50 and simple ROI is 50%."
                },
                "reason": {
                  "zh": "完整成本40+60=100；净收益150-100=50；ROI=50%。",
                  "en": "Total cost is 40+60=100; net benefit is 150-100=50; ROI is 50%."
                },
                "fields": [
                  {
                    "id": "cost",
                    "label": {
                      "zh": "完整成本",
                      "en": "Total cost"
                    },
                    "expected": 100
                  },
                  {
                    "id": "roi",
                    "label": {
                      "zh": "ROI百分数",
                      "en": "ROI percentage"
                    },
                    "expected": 50
                  }
                ],
                "unitIds": [
                  "unit-2"
                ]
              }
            ]
          },
          "questions": [
            {
              "id": "question-2",
              "unitIds": [
                "unit-2"
              ],
              "q": "本演练的简单ROI是多少？",
              "a": "50%",
              "wrong": [
                "150%"
              ],
              "en": {
                "q": "What is the exercise ROI?",
                "a": "50%",
                "wrong": [
                  "150%"
                ]
              },
              "quote": "本演练在同一期间的部署成本为40，运行成本为60，已兑现收益为150。完整成本100，净收益50，简单ROI为50%。",
              "mode": "scenario"
            }
          ]
        }
      ]
    },
