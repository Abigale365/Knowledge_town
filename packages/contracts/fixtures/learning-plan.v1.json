              "en": "The numbers and sequence in this case are for acceptance testing."
            },
            "rounds": [
              {
                "id": "access",
                "type": "matrix",
                "prompt": {
                  "zh": "本演练中，客服只需要读取政策，运维只需要读取日志。不能因为使用AI就让所有角色访问所有资料。",
                  "en": "In this exercise, support only reads policies and operations only reads logs. Using AI does not justify giving every role access to every source."
                },
                "reason": {
                  "zh": "只授予角色完成工作所需的权限。",
                  "en": "Grant only the access each role needs."
                },
                "rows": [
                  {
                    "id": "support",
                    "text": {
                      "zh": "客服",
                      "en": "Support"
                    }
                  },
                  {
                    "id": "ops",
                    "text": {
                      "zh": "运维",
                      "en": "Operations"
                    }
                  }
                ],
                "columns": [
                  {
                    "id": "policy",
                    "text": {
                      "zh": "政策",
                      "en": "Policies"
                    }
                  },
                  {
                    "id": "logs",
                    "text": {
                      "zh": "日志",
                      "en": "Logs"
                    }
                  }
                ],
                "expected": [
                  "support:policy",
                  "ops:logs"
                ],
                "unitIds": [
                  "unit-3"
                ]
              }
            ]
          },
          "questions": [
            {
              "id": "question-3",
              "unitIds": [
                "unit-3"
              ],
              "q": "本演练中客服应能做什么？",
              "a": "读取政策",
              "wrong": [
                "读取日志"
              ],
              "en": {
                "q": "What should support be allowed to do?",
                "a": "Read policies",
                "wrong": [
                  "Read logs"
                ]
              },
              "quote": "本演练中，客服只需要读取政策，运维只需要读取日志。不能因为使用AI就让所有角色访问所有资料。",
              "mode": "scenario"
            }
          ]
        }
      ]
