{
  "name": "knowledge-town",
  "version": "0.14.1",
  "private": true,
  "description": "Reading-first chapter adventures with a configurable local course-generation API",
  "scripts": {
    "test": "node scripts/test-current.cjs",
    "check": "node scripts/check-repository.cjs",
    "start": "node server.cjs",
    "test:chapters": "node --test tests/chapter.test.cjs tests/adventures.test.cjs tests/course-api.test.cjs",
    "test:adventures": "node tests/adventures-ui.cjs",
    "test:exploration": "node tests/exploration-ui.cjs",
    "test:knowledge": "node --test tests/knowledge.test.cjs && node tests/knowledge-ui.cjs",
    "test:workshops": "node --test tests/workshops.test.cjs && node tests/workshops-ui.cjs"
  },
  "engines": {
    "node": ">=22"
  }
}
