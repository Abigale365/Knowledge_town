{
  "name": "knowledge-town",
  "version": "0.16.0",
  "private": true,
  "description": "Reading-first chapter adventures with a configurable local course-generation API",
  "scripts": {
    "test": "node scripts/test-current.cjs",
    "check": "node scripts/check-repository.cjs",
    "start": "node server.cjs",
    "test:chapters": "node --test tests/chapter.test.cjs tests/adventures.test.cjs tests/course-api.test.cjs",
    "test:adventures": "node tests/adventures-ui.cjs",
    "test:exploration": "node tests/exploration-ui.cjs",
    "test:knowledge": "node --test tests/knowledge.test.cjs && node tests/knowledge-ui.cjs",
    "test:workshops": "node --test tests/workshops.test.cjs && node tests/workshops-ui.cjs",
    "test:languages": "node --test tests/language.test.cjs && node tests/bilingual-ui.cjs",
    "build": "node scripts/build-game.cjs",
    "build:content": "python scripts/build-chapter-course.py",
    "check:contracts": "node scripts/check-contracts.cjs",
    "test:contracts": "node --test tests/pipeline-contracts.test.cjs",
    "test:knowledge-module": "node scripts/test-module.cjs knowledge",
    "test:design-module": "node scripts/test-module.cjs design",
    "test:game": "node scripts/test-module.cjs game",
    "preview:game": "node scripts/preview-game.cjs --dir artifacts/previews/game-C --port 8773"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
